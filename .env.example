# Copy this file to .env and fill in your keys.
#   cp .env.example .env
# .env is gitignored. Never commit real keys.

# --- Alpaca ------------------------------------------------------------------
# Get PAPER keys (they start with PK) from:
#   https://app.alpaca.markets/paper/dashboard/overview  ->  API Keys
# Paper trading is free, works worldwide, and uses fake money.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# true  = paper money. Keep it here until a strategy has proved itself.
# false = REAL MONEY. Do not change this until you have run on paper for months.
ALPACA_PAPER=true

# Which price feed to use.
#   iex = free. Volume figures cover only part of the market, but the volume
#         rules compare a day against its own average, so they still work.
#   sip = the full market tape. Needs a paid Alpaca data plan.
ALPACA_DATA_FEED=iex

# --- Ports -------------------------------------------------------------------
# Change these if something else on your machine already uses them.
BACKEND_PORT=8020
FRONTEND_PORT=5180
CORS_ORIGINS=http://localhost:5180

# --- App ---------------------------------------------------------------------
LOG_LEVEL=INFO
